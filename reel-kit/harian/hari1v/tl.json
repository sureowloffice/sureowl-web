i", "janji."]], [48.216, 52.19, "Jadi gue kerja semaleman…", ["semaleman"]], [53.79, 57.76, "…dan jadilah… TOKO ROTI pertama Kota Seni!", ["TOKO", "ROTI"]], [58.26, 61.521, "Masalahnya… kita punya roti. Tapi rumah? Nol.", ["roti.", "Nol"]], [61.821, 68.366, "Roti pertama buat warga lama. Malam ini semua tidur di toko roti. Wanginya enak… lantainya keras.", ["warga", "lama", "keras"]], [68.566, 72.419, "Besok: A, rumah di atas bukit. B, sekolah di tengah kota. Komen!", ["A,", "B,", "Komen!"]], [72.719, 74.297, "Eh… roti gue tadi sepuluh, kan?", ["sepuluh"]], [74.697, 77.966, "Bantu follow, biar kebagian roti.", ["follow"]]], "SUB2": [[0.15, 1.638, "WOI… ITU WARGA?!", ["WARGA"]], [1.888, 3.905, "Kemarin warga kota", ["491!", "satu."]], [3.905, 4.914, "ini satu.", ["491!", "satu."]], [4.914, 6.259, "Itu pun gue.", ["491!", "satu."]], [6.259, 7.828, "Sekarang… 491!", ["491!", "satu."]], [8.128, 9.054, "Gue terharu.", ["terharu.", "panik.", "Wi-fi"]], [9.054, 10.211, "Tapi gue panik.", ["terharu.", "panik.", "Wi-fi"]], [10.211, 11.446, "Rumah nggak ada.", ["terharu.", "panik.", "Wi-fi"]], [11.446, 12.526, "Wi-fi apalagi.", ["terharu.", "panik.", "Wi-fi"]], [12.726, 13.595, "Tunggu… itu…", ["WARGA", "LAMA"]], [13.595, 14.464, "WARGA LAMA?!", ["WARGA", "LAMA"]], [14.714, 16.167, "Kota kita hancur…", ["balik"]], [16.167, 17.705, "tapi kalian balik.", ["balik"]], [18.005, 19.428, "Lima menit kemudian…", ["ribut", "rumah", "gedung"]], [19.428, 20.353, "kalian ribut.", ["ribut", "rumah", "gedung"]], [20.353, 21.136, "Kubu rumah,", ["ribut", "rumah", "gedung"]], [21.136, 22.417, "lawan kubu gedung.", ["ribut", "rumah", "gedung"]], [22.617, 23.92, "Terus ada yang cuma", ["'aku'", "Selamat"]], [23.92, 24.743, "komen 'aku'.", ["'aku'", "Selamat"]], [24.743, 25.978, "Iya. Kalian warga.", ["'aku'", "Selamat"]], [25.978, 26.527, "Selamat.", ["'aku'", "Selamat"]], [26.827, 27.891, "Terus kenapa semua", ["BOS", "pesawatnya"]], [27.891, 28.895, "pengen jadi BOS?!", ["BOS", "pesawatnya"]